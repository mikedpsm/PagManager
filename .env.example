# Copy to .env for Docker Compose. For a local API process, provide the runtime
# variables below through its environment (the API does not load .env itself).
# All secrets here are placeholders; replace them before deployment.

# API runtime configuration
# PORT defaults to 5000 locally. Compose fixes the container port at 8080;
# APP_PORT below controls the exposed host port.
PORT=5000
# DATA_DIR defaults to ./data, relative to the process working directory.
# Stores PGlite data and the generated JWT secret. Compose uses /data instead.
DATA_DIR=./data
# DATABASE_URL is optional: leave it unset to use persistent PGlite.
# Uncomment and replace credentials to use local PostgreSQL. Do not set it empty.
# Compose builds its own URL from the POSTGRES_* variables below.
# DATABASE_URL=postgres://pagmanager:replace-with-a-unique-url-safe-password@localhost:5432/pagmanager
# With PostgreSQL, production requires an explicit JWT_SECRET; generate it with
# `openssl rand -hex 32`. In PGlite mode, a strong secret is generated, persisted
# in DATA_DIR, and validated in production too.
JWT_SECRET=
# Production requires the exact public browser origin, for example
# https://pagmanager.example.com. Paths are rejected; a trailing slash is normalized.
CORS_ORIGIN=https://pagmanager.example.com

# Docker Compose configuration
# Use a URL-safe password (letters and digits) because Compose builds the URL.
POSTGRES_DB=pagmanager
POSTGRES_USER=pagmanager
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
APP_PORT=8080
