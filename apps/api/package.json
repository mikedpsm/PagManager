{
  "name": "@pagmanager/api",
  "version": "0.1.0",
  "private": true,
  "description": "PagManager HTTP API: Hono + zod-openapi service exposing auth, clients, invoices and dashboard endpoints",
  "type": "module",
  "main": "./dist/server.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@pagmanager/contracts": "workspace:*",
    "@pagmanager/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
