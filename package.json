{
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "lefthook": "2.1.14",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "name": "pagmanager",
  "description": "PagManager is a self-hosted billing management web app for clients, invoices, and payment tracking.",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "start": "node apps/api/dist/server.mjs",
    "build:shared": "pnpm --filter @pagmanager/contracts build && pnpm --filter @pagmanager/db build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @pagmanager/api --filter @pagmanager/web dev",
    "dev:docker": "pnpm build:shared && pnpm --parallel --filter @pagmanager/contracts --filter @pagmanager/db --filter @pagmanager/api --filter @pagmanager/web dev",
    "build": "pnpm --filter @pagmanager/contracts build && pnpm --filter @pagmanager/db build && pnpm --filter @pagmanager/api build && pnpm --filter @pagmanager/web build",
    "test:e2e": "node e2e/run.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "lefthook install",
    "typecheck": "tsc -b",
    "test": "pnpm build:shared && vitest run",
    "db:migrate": "pnpm --filter @pagmanager/db migrate",
    "db:seed": "pnpm --filter @pagmanager/db seed",
    "db:generate": "pnpm --filter @pagmanager/db generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikedpsm/PagManager.git"
  },
  "keywords": [],
  "author": "Maicon Douglas",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mikedpsm/PagManager/issues"
  },
  "homepage": "https://github.com/mikedpsm/PagManager#readme"
}
